{
  "name": "cipher-agent-pay",
  "version": "0.1.0",
  "private": true,
  "description": "The encrypted policy layer for autonomous AI agent treasuries, built on Zama FHEVM.",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "frontend:dev": "vite --config frontend/vite.config.ts",
    "frontend:build": "vite build --config frontend/vite.config.ts",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "keywords": [
    "zama",
    "fhevm",
    "confidential-payments",
    "ai-agent",
    "openbuild"
  ],
  "dependencies": {
    "@fhevm/solidity": "^0.11.1",
    "@openzeppelin/contracts": "^5.6.1",
    "@zama-fhe/relayer-sdk": "^0.4.1",
    "ethers": "^6.16.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "^0.4.2",
    "@fhevm/mock-utils": "^0.4.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "chai": "^4.5.0",
    "eslint": "^10.3.0",
    "hardhat": "^2.28.6",
    "mocha": "^11.7.5",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.10"
  }
}
